[
  {
    "origin": ["*"],
    "method": ["PUT", "OPTIONS", "GET", "POST", "HEAD"],
    "responseHeader": [
      "Content-Type",
      "x-goog-resumable",
      "x-goog-content-length-range",
      "Access-Control-Allow-Origin",
      "Access-Control-Allow-Methods",
      "Access-Control-Allow-Headers",
      "Access-Control-Max-Age"
    ],
    "maxAgeSeconds": 3600
  }
]