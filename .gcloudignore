.git/
.gitignore

# Ambiente
.env
.env.local
.env*.local

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Testes
coverage/
.nyc_output/

# Documentação
*.md
!README.md

# Outros projetos
Capacity_final/
quality original/

# Vercel
.vercel/
vercel.json

